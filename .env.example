# ─── AGENTMAXX ENVIRONMENT CONFIGURATION ───

# 1. Google Gemini API Key (Required for Live Mode)
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Gemini Model Selection
GEMINI_MODEL=gemini-2.5-flash

# 3. Agent Runtime Mode: 'live' or 'mock' (Defaults to 'live' if GEMINI_API_KEY is present)
AGENT_MODE=live

# 4. Optional Web Search API Key (Tavily API for deep web scraping)
# If empty, the engine uses the verified Wikipedia Live Knowledge API (Free & Real)
TAVILY_API_KEY=

# 5. Persistent Storage Volume Directory (Single-node Demo Deployment)
# Set to persistent volume mount point, e.g. /data or ./storage
DATA_DIR=

# 6. Cryptographic Session Authentication Secret (Min 32 characters)
AUTH_SECRET=agentmaxx_session_secret_key_2026_change_in_prod

# 7. Blockchain Network RPC (Base Sepolia L2 Testnet)
BASE_RPC_URL=https://sepolia.base.org

# 8. (Optional) Agent Testnet Wallet Private Key (0x...)
# Leave empty to generate a secure autonomous wallet via the UI
WALLET_PRIVATE_KEY=
